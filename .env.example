# Put OPENROUTER_API_KEY in .env.server only (not in .env).
# Expo reads .env and must never see the key.

# Free OpenRouter models used by the Vessel Agent SDK
VESSEL_AGENT_MODEL=minimax/minimax-m3:free
VESSEL_AGENT_FALLBACK_MODELS=thinkingmachines/inkling:free,openrouter/free
VESSEL_TTS_MODELS=deepgram/flux-tts:free,fish-audio/s2.1-pro-free:free

PORT=4001

# Shared SOGN SAFE hub.
# Local: http://localhost:4000
# Production: https://<your-hub>.up.railway.app
PLATFORM_URL=http://localhost:4000

# Expo public URLs (safe to ship — no secrets).
# On Vercel set both to the Railway hub URL and redeploy.
EXPO_PUBLIC_PLATFORM_URL=http://localhost:4000
EXPO_PUBLIC_AGENT_URL=http://localhost:4001
